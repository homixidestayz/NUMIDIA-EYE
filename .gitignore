# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/

# Environment
.env

# Runtime-regenerable data (audit snapshots, processed artifacts, app DB).
# NEVER a source of truth - production reads the database, tests use fixtures.
data/raw/firms/*
!data/raw/firms/.gitkeep
# Labeling ground truth raw downloads (120MB+ EMS/EFFIS/VNF) and FIRMS
# history pulls - regenerable via documented pinned URLs + pull-history
# command (see docs/dataset-report-v1.md). The curated dataset itself
# (firms_labels_v1.csv, firms_excluded_v1.csv, manifest_v1.json) IS committed.
data/labels/ground_truth/
data/labels/firms_history/
data/processed/*.parquet
data/processed/*.json
data/evaluation/*
data/db/
*.db
*.db-wal
*.db-shm

# ML artifacts
services/ml/models/*
services/ml/artifacts/*

# verifier_v2 is redistributed with full provenance in MODEL_LICENSE.md
# (founder-authorized 2026-10-09). Uncomment the next line to keep the 48.5 MB
# artifact out of Git and rely on the rebuild path in docs/SETUP.md instead.
# services/ml/models/verifier_v2/model.joblib
!services/ml/models/verifier_v2/
services/ml/models/verifier_v2/*
!services/ml/models/verifier_v2/manifest.json
!services/ml/models/verifier_v2/config.json
!services/ml/models/verifier_v2/metrics.json
!services/ml/models/verifier_v2/calibration.csv
!services/ml/models/verifier_v2/feature_importance.csv
!services/ml/models/verifier_v2/model.joblib

# Node
node_modules/
apps/web/dist/
apps/web/tsconfig.tsbuildinfo
# NOTE: apps/web/package-lock.json is deliberately NOT ignored. The lockfile is
# how a fresh clone gets identical dependency versions (256 packages, lockfile
# v3); ignoring it makes `npm ci` impossible and defeats reproducible installs.

# OS / editors
.DS_Store
Thumbs.db
.idea/
.vscode/

# Superpowers scratch (plan briefs, ledger, review packages)
.superpowers/