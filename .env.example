# NUMIDIA EYE configuration. Copy to .env.
# Everything is optional — the project runs offline on the committed historical
# sample; sources that are missing report honest UNAVAILABLE states.

# NASA FIRMS (free MAP_KEY: https://firms.modaps.eosdis.nasa.gov/api/map_key/)
FIRMS_MAP_KEY=

# NRT sources queried by the ingestion worker (comma separated)
FIRMS_SOURCES=VIIRS_NOAA21_NRT,VIIRS_SNPP_NRT,VIIRS_NOAA20_NRT

# API
NUMIDIA_API_HOST=0.0.0.0
NUMIDIA_API_PORT=8000