# NUMIDIA EYE configuration. Copy to .env.  (cp .env.example .env)
#
# Every value here is OPTIONAL and none of them is required to run the project.
# With no .env at all you can still:
#   1. populate a database from the keyless public FIRMS archive
#        uv run python -m numidia_worker.cli --db data/db/numidia.db fetch --mode archive
#   2. start the API on port 8010
#   3. serve apps/site on port 5500
# Anything missing reports an honest UNAVAILABLE state; nothing is invented.
# Full instructions: docs/SETUP.md

# --- NASA FIRMS -----------------------------------------------------------
# Only needed for LIVE NRT ingestion. The public archive route above needs no key.
# Free key: https://firms.modaps.eosdis.nasa.gov/api/map_key/
# Server-side only: never committed, never sent to a browser, redacted from
# every stored URL and response.
FIRMS_MAP_KEY=

# NRT sources queried by the ingestion worker (comma separated)
FIRMS_SOURCES=VIIRS_NOAA21_NRT,VIIRS_SNPP_NRT,VIIRS_NOAA20_NRT

# --- AI verifier ----------------------------------------------------------
# Point this at a verified artifact directory to serve real verdicts.
# Left unset or empty, /ai returns 503 AI_UNAVAILABLE with probability null --
# that is the fail-closed default, not an error.
#
# Verify an artifact before trusting it (read-only, registers nothing):
#   uv run python -m numidia_ml.cli verify-artifact \
#     --artifact services/ml/models/verifier_v2/model.joblib \
#     --dataset   data/labels/firms_labels_v2.csv \
#     --metrics   services/ml/models/verifier_v2/metrics.json
NUMIDIA_ACTIVE_MODEL=services/ml/models/verifier_v2

# --- API ------------------------------------------------------------------
# Port 8010 is the project default because 8000 is occupied by another service
# on the reference machine. apps/site reads API_PORT from its own code and can
# be overridden with ?api=<port> in the page URL.
NUMIDIA_API_HOST=0.0.0.0
NUMIDIA_API_PORT=8010

# --- Storage --------------------------------------------------------------
# SQLite WAL database. Gitignored; recreated by the archive route above.
# NUMIDIA_DB_PATH=data/db/numidia.db